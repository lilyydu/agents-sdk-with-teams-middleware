<?xml version="1.0" encoding="utf-8"?>
<!--
  Sample-scoped NuGet configuration.

  This file is intentionally local to the TeamsMiddlewareSample so the Teams SDK
  preview feed is NOT added to the enclosing repo's root nuget.config. NuGet walks
  up from the project directory and uses the nearest config, so building from within
  this folder picks this up. The <clear/> makes the source list deterministic rather
  than inheriting/merging the repo-root sources.

  The TeamsMiddlewareSample.csproj pins the exact preview version via VersionOverride
  on the Microsoft.Teams.Apps PackageReference.

  NOTE: TeamsSDKPreviews is an authenticated Azure DevOps feed. Run an interactive
  restore once to cache credentials (requires the Azure Artifacts Credential Provider)
  by passing the interactive flag to "dotnet restore".
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget" value="https://api.nuget.org/v3/index.json" />
    <add key="TeamsSDKPreviews" value="https://pkgs.dev.azure.com/DomoreexpGithub/Github_Pipelines/_packaging/TeamsSDKPreviews/nuget/v3/index.json" />
  </packageSources>

  <!-- Central Package Management requires source mapping when more than one source is
       defined (NU1507). Teams SDK preview packages resolve from TeamsSDKPreviews;
       everything else from nuget.org. -->
  <packageSourceMapping>
    <packageSource key="nuget">
      <package pattern="*" />
    </packageSource>
    <packageSource key="TeamsSDKPreviews">
      <package pattern="Microsoft.Teams.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
