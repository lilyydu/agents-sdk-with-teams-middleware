# ─────────────────────────── Secrets / local config ───────────────────────────
# Never commit real bot credentials. Keep .env.example committed; ignore the rest.
.env
.env.*
!.env.example
appsettings.Development.json
appsettings.local.json
*.pem
*.pfx

# ─────────────────────────────── Python ───────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
*.pth
VERSION.txt
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ───────────────────────────── Node / TypeScript ─────────────────────────────
node_modules/
# dist/ is covered under Python above (build output for both ecosystems)
*.tsbuildinfo
coverage/
.turbo/
npm-debug.log*
yarn-error.log*

# ─────────────────────────────── .NET ───────────────────────────────
bin/
obj/
*.user
# App package built/downloaded by the Teams CLI (teams app package download)
*.zip

# ─────────────────────────────── Logs ───────────────────────────────
*.log

# ──────────────────────────── OS / editor ────────────────────────────
.DS_Store
Thumbs.db
.vs/
.vscode/
.idea/
*.swp
